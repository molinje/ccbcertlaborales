<mvc:View controllerName="ccb.org.certlaborales.controller.Viewini"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">
     <content>
            <form:SimpleForm id="formCertvolante"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanXL="4" emptySpanL="4" emptySpanM="2" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1">

                <core:Title text="Certificados Laborales" />

                <Label text="Empleado" />
                <Text id="txtPernr" text="{globalData>/userData/d/Pernr}" />

                <Label text="Nombre" />
                <Text id="txtNombre" text="{globalData>/userData/d/Nombre}" />

                <Label text="Otro Numero de personal" />
                <Input id="inpOtroPernr"
                    value="{viewiniView>/otroPernr}"
                    type="Number"
                    maxLength="8"
                    liveChange="onOtroPernrLiveChange"
                    change="onOtroPernrChange"
                    visible="{= ${globalData>/userData/d/TienePermiso} === true }"
                    editable="{= ${globalData>/userData/d/TienePermiso} === true }" />

                <Label text="Fecha" />
                <DatePicker id="dpFecha" dateValue="{viewiniView>/fecha}" displayFormat="dd.MM.yyyy" />

                <Label text="Tipo de Certificado" />
                <Select id="selTipoCertificado" selectedKey="{viewiniView>/idCertificado}" items="{globalData>/tiposCertificado}">
                    <core:Item key="{globalData>Id}" text="{globalData>Descripcion}" />
                </Select>

                <Label text="Incluir en el Certificado" />
                <HBox class="sapUiSmallGap">
                    <CheckBox id="cbTipoContrato" text="Tipo de Contrato" selected="{viewiniView>/tipoContrato}" />
                    <CheckBox id="cbSalario" text="Salario" selected="{viewiniView>/salario}" />
                    <CheckBox id="cbCargo" text="Cargo" selected="{viewiniView>/cargo}" />
                    <CheckBox id="cbArea" text="Area" selected="{viewiniView>/area}" />
                </HBox>

            </form:SimpleForm>
        </content>
        <footer>
            <Bar>
                <contentRight>
                    <Button id="btnGenerar" text="GENERAR" type="Emphasized" press="onGenerar" />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
